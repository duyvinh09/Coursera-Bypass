{
  "manifest_version": 3,
  "name": "Coursera Bypass",
  "version": "1.5",
  "description": "Tua video, tự chuyển bài, bắt đầu bài tập và tích ô đồng ý. Khi copy chỉ giữ đề, lựa chọn và code.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [],
  "host_permissions": ["*://*.coursera.org/*"],
  "content_scripts": [
    {
      "matches": ["*://*.coursera.org/learn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Coursera Quick Skip (Bật/tắt)",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
